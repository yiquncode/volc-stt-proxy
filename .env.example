# volc-stt-proxy configuration. Copy to .env (same directory you run the binary from)
# and fill in. Real environment variables take precedence over this file.

# Backend: Doubao streaming ASR 2.0, "一句话识别" mode (WebSocket bigmodel_nostream).
# The 豆包语音 console must have 豆包流式语音识别模型2.0 activated (claim the 20 h trial
# by clicking 试用).

# --- Volcengine credentials: choose ONE of the two options -------------------
# The two key types are NOT interchangeable, and Ark/方舟 API keys do not work.

# Option A (new console / 新版控制台 > API Key管理): a single API key, sent as X-Api-Key.
VOLC_API_KEY=

# Option B (legacy console / 旧版控制台): APP ID + Access Token, sent as
# X-Api-App-Key and X-Api-Access-Key. If BOTH are set they are used instead of VOLC_API_KEY.
# VOLC_APP_KEY=
# VOLC_ACCESS_KEY=

# --- Volcengine request options (defaults shown) -----------------------------

# Must match what you activated: 小时版 = volc.seedasr.sauc.duration,
# 并发版 = volc.seedasr.sauc.concurrent.
# VOLC_RESOURCE_ID=volc.seedasr.sauc.duration
# VOLC_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
# VOLC_MODEL_NAME=bigmodel

# 语义顺滑 (request.enable_ddc): removes filler words and repetitions.
# enable_itn and enable_punc are always on.
# VOLC_ENABLE_DDC=true

# Optional recognition language, sent as audio.language (Volcengine codes, e.g. zh-CN, en-US).
# Leave empty to let the model auto-detect (Chinese incl. dialects, English). The OpenAI "language"
# field sent by clients is ignored because its codes differ from Volcengine's.
# VOLC_LANGUAGE=

# --- Proxy options -----------------------------------------------------------

# Address to listen on.
# LISTEN_ADDR=127.0.0.1:8090

# If set, clients must send "Authorization: Bearer <PROXY_API_KEY>" on the transcription and models routes.
# If empty, any (or no) Authorization header is accepted.
# PROXY_API_KEY=

# Base timeout (Go duration syntax). Bounds reading the upload, and separately
# waiting for a free worker.
# REQUEST_TIMEOUT=60s

# The Volcengine session gets REQUEST_TIMEOUT + estimated audio seconds × this factor,
# where the estimate is upload bytes / 32000 (e.g. 10 min: 60s + 600 × 0.5 = 6 min).
# TIMEOUT_PER_AUDIO_SECOND=0.5

# Maximum request body in MB (~12 min of 16 kHz mono 16-bit WAV); larger gets 413.
# The upload is held in memory while it is processed.
# MAX_UPLOAD_MB=24
